<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ElasticSearchE2ETests-part1" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="org.alfresco.utility.report.HtmlReportListener"/>
        <listener class-name="org.alfresco.utility.testrail.TestRailExecutorListener"/>
        <listener class-name="org.alfresco.utility.testng.OSTestMethodSelector"/>
    </listeners>
    <test name="SearchTests-Part1">
        <!-- 1. org.alfresco.rest.search.NodeContentTest: not part of the migrated Search API tests
             2. org.alfresco.rest.search.crosslocale: cross-locale search is not supported on ES
             3. org.alfresco.rest.search.fingerprint: fingerprint search is not supported on ES
             4. org.alfresco.rest.search.tracker: Solr tracker cascade; also needs runtime custom model, ACS-12502 -->
        <packages>
            <package name="org.alfresco.rest.search.part1"/>
        </packages>
        <classes>
            <!-- 1) SearchCasesTest.testSearchExactTermQueries: '=' exact-term operator is disabled by default on Search Enterprise; enable in follow-up PR -->
            <class name="org.alfresco.rest.search.part1.SearchCasesTest">
                <methods>
                    <exclude name="testSearchExactTermQueries"/>
                </methods>
            </class>
            <!-- 2) SearchAspectTest.testAspectIsRemovedWithItsProperties: Batch Indexing custom model deployment at runtime gap (https://hyland.atlassian.net/browse/ACS-12502) -->
            <class name="org.alfresco.rest.search.part1.SearchAspectTest">
                <methods>
                    <exclude name="testAspectIsRemovedWithItsProperties"/>
                </methods>
            </class>
            <!-- 3) SearchHighLightTest.searchNonIndexedData:AFTS bare-property-name parsing gap on ES (returns HTTP 500) -->
            <class name="org.alfresco.rest.search.part1.SearchHighLightTest">
                <methods>
                    <exclude name="searchNonIndexedData"/>
                </methods>
            </class>
            <!-- 4) SearchExactTermTest: Excluded as it's @BeforeClass waits ~40 min for 'tok:' documents that are never
                    indexed on ES (Batch Indexing runtime custom model gap, tokenised-model.xml 'tok' prefix,
                    https://hyland.atlassian.net/browse/ACS-12502). Do NOT re-enable the two exception-only tests individually -
                    they assert HTTP 500/501 and pass without indexed data, so they add no coverage but restore the full wait.
                    Re-enable the whole class once ACS-12502 is fixed. -->
            <class name="org.alfresco.rest.search.part1.SearchExactTermTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <!-- 5) SearchSpellCheckTest: need separate profile and Solr specific tests -->
            <class name="org.alfresco.rest.search.part1.SearchSpellCheckTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <!-- 6) SearchNonIndexedFields.testNonIndexedDoesNotExist:uses Solr-only Luke admin endpoint /solr/alfresco/admin/luke
                    SearchNonIndexedFields.testIndexedAndNonIndexedField():Batch Indexing custom model deployment at runtime gap
                    (https://hyland.atlassian.net/browse/ACS-12502) -->
            <class name="org.alfresco.rest.search.part1.SearchNonIndexedFields">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <!-- 7) SearchAPATHTest: APATH is a Solr-only indexed field -->
            <class name="org.alfresco.rest.search.part1.SearchAPATHTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <!-- 8) SearchWithCustomModelTest: Batch Indexing custom model deployment at runtime gap, https://hyland.atlassian.net/browse/ACS-12502 -->
            <class name="org.alfresco.rest.search.part1.SearchWithCustomModelTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>