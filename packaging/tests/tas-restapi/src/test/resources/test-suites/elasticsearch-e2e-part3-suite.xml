<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ElasticSearchE2ETests-Part3" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="org.alfresco.utility.report.HtmlReportListener"/>
        <listener class-name="org.alfresco.utility.testrail.TestRailExecutorListener"/>
        <listener class-name="org.alfresco.utility.testng.OSTestMethodSelector"/>
    </listeners>

    <test name="SearchMigrationAdvancedScenarios">
        <packages>
            <package name="org.alfresco.rest.search.part3"/>
        </packages>
        <classes>
            <!-- Run in elasticsearch-e2e-part5-suite.xml -->
            <class name="org.alfresco.rest.search.part3.SearchSecondaryAssociationAdvancedTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <class name="org.alfresco.rest.search.part3.SearchDeepFolderHierarchyTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
            <class name="org.alfresco.rest.search.part3.SearchTagsTest">
                <methods>
                    <exclude name=".*"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>