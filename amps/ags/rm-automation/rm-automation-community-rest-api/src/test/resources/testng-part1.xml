<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="TestNG AllTestSuite - part1" configfailurepolicy="continue" verbose="1" time-out="300000">
   <listeners>
      <listener class-name="org.alfresco.utility.testng.AlphabeticalPriorityInterceptor" />
   </listeners>
   <!-- CI runs testng.xml in two halves of similar duration. This half lists its packages explicitly;
        testng-part2.xml runs the rest, so new packages are picked up there. Keep both files in sync. -->
   <test name="restapi-part1" preserve-order="false">
      <packages>
         <package name="org.alfresco.rest.rm.community.hold.*"/>
         <package name="org.alfresco.rest.rm.community.retentionschedule.*"/>
         <package name="org.alfresco.rest.rm.community.files.*"/>
         <package name="org.alfresco.rest.rm.community.fileplans.*"/>
         <package name="org.alfresco.rest.rm.community.recordfolders.*"/>
         <package name="org.alfresco.rest.rm.community.unfiledcontainers.*"/>
         <package name="org.alfresco.rest.rm.community.site.*"/>
         <package name="org.alfresco.rest.rm.community.rmroles.*"/>
         <package name="org.alfresco.rest.rm.community.recordcategories.*"/>
         <package name="org.alfresco.rest.rm.community.rules.*"/>
         <package name="org.alfresco.rest.rm.community.unfiledrecordfolders.*"/>
      </packages>
   </test>
</suite>
