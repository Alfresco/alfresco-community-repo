<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ElasticSearchE2ETests-part5" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="org.alfresco.utility.report.HtmlReportListener"/>
        <listener class-name="org.alfresco.utility.testrail.TestRailExecutorListener"/>
        <listener class-name="org.alfresco.utility.testng.OSTestMethodSelector"/>
    </listeners>
    <!-- Classes of org.alfresco.rest.search.part3 split out of elasticsearch-e2e-part3-suite.xml to shorten the CI job; keep both in sync -->
    <test name="SearchMigrationAdvancedScenarios-Part5">
        <classes>
            <class name="org.alfresco.rest.search.part3.SearchSecondaryAssociationAdvancedTest"/>
            <class name="org.alfresco.rest.search.part3.SearchDeepFolderHierarchyTest"/>
            <class name="org.alfresco.rest.search.part3.SearchTagsTest"/>
        </classes>
    </test>
</suite>
